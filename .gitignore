# ---------------------------------------------------------------------------
# PARTICIPANT DATA NEVER GOES TO GITHUB
# Unity writes recordings into Assets/Data and Assets/Logs. Move them to the
# course's shared data folder after each session (see docs/05-data-and-sync.md).
# ---------------------------------------------------------------------------
/[Aa]ssets/[Dd]ata/*
!/[Aa]ssets/[Dd]ata/.gitkeep
/[Aa]ssets/[Ll]ogs/*
!/[Aa]ssets/[Ll]ogs/.gitkeep
/data/
/[Ff]inal[Dd]ata*/
*.edf
*.bdf
*.xdf
# EmotivPRO exports and any other recording files, wherever they end up
*_intervalMarker.csv
*EPOCX*.csv
*eyeTr-*.csv
*rtData-*.csv
*events-*.csv
runData.csv

